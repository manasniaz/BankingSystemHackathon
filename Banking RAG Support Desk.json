      "position": [
        608,
        672
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "XUIXSrkzGKEEyyXp",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"draft\": \"The full customer reply text, grounded only in retrieved policy.\",\n  \"grounded\": true,\n  \"confidence\": 0,\n  \"citations\": [\n    \"doc_id_1\",\n    \"doc_id_2\"\n  ],\n  \"needs_human\": false\n}"
      },
      "id": "9bde1ec2-6281-4107-a007-dce5e4e176b4",
      "name": "Draft Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        768,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "grounded",
              "leftValue": "={{ $json.output.grounded }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "needshuman",
              "leftValue": "={{ $json.output.needs_human }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "conf",
              "leftValue": "={{ $json.output.confidence }}",
              "rightValue": 0.7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "hascitations",
              "leftValue": "={{ $json.output.citations.length }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "f2b91d3d-189f-48b0-9788-dfe180802ba7",
      "name": "Grounded & Confident?",
