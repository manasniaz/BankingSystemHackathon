      "id": "d89dde63-41e1-441b-b0b8-620fb85f7055",
      "name": "Build Query",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        208
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.question }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a bank support drafting assistant. Use the Policy Knowledge Base tool to find relevant policy before answering. STRICT RULES: (1) Only state policies, fees, timelines, or numbers that appear in retrieved documents. (2) If retrieved policy does not clearly cover the question, set grounded=false, needs_human=true, and write a draft that says the query is being escalated to a specialist — never invent an answer. (3) Always list the doc_ids you used in citations. (4) Set confidence between 0 and 1 reflecting how well policy covers the question. (5) Past resolved cases may guide tone only, never facts. Return ONLY the structured JSON."
        }
      },
      "id": "08057363-9eee-4d40-a0c4-18f124b16a60",
      "name": "Draft Grounded Reply",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        512,
        208
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "55380aab-0b9c-441c-a16a-81ede239258a",
      "name": "Groq Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        448,
        432
      ],
      "credentials": {
        "groqApi": {
          "id": "f0I08FemfuBnyTu1",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search official bank policy documents (card declines, fees, overdraft, dispute rights). Only use facts returned here; never invent policy.",
        "pineconeIndex": {
          "__rl": true,
          "value": "banking-rag",
          "mode": "list",
          "cachedResultName": "banking-rag"
        },
        "options": {
          "pineconeNamespace": "policy"
        }
      },
      "id": "5f570aac-02ec-4126-8d26-ccc724783ddb",
