          "id": "I2iSFV2W31PGiVaK",
          "name": "Pinecone account"
        }
      }
    },
    {
      "parameters": {},
      "id": "92735925-5bbc-4258-91c6-1a33750e7fe2",
      "name": "Gemini Embeddings",
