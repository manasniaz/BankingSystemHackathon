          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"fraud_detected\": true,\n  \"hold_placed\": true,\n  \"hold_id\": {{ JSON.stringify($json) }},\n  \"fraud_assessment_id\": \"{{ $('Validate Python Response Schema').item.json.fraud_assessment_id || '' }}\",\n  \"risk_score\": {{ $('Validate Python Response Schema').item.json.risk_score || 100 }}\n}",
        "options": {
