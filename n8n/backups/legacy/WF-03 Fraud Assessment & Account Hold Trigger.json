        "message": "={{ \"A fraud hold has been placed on an account.\\n\\nAccount ID: \" + $('Validate Request Payload').item.json.params.account_id + \"\\nAmount Assessed: \" + $('Validate Request Payload').item.json.params.amount + \" cents\\nRisk Score: \" + $('Validate Python Response Schema').item.json.risk_score + \"\\nReason: \" + ($('Validate Python Response Schema').item.json.reason || 'High risk score detected') + \"\\n\\nHuman action required: Review and release the hold via the release_account_hold RPC if this is a false positive.\" }}",
        "options": {
