      },
      "id": "70624746-78ca-40c3-8c9a-4760f68453a0",
      "name": "Webhook - Fraud Assessment Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1408,
        208
      ],
      "webhookId": "wf-03-fraud-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nif (!body.account_id || !uuidRegex.test(body.account_id)) {\n  return [{ json: { isValid: false, validationError: 'account_id must be a valid UUID' } }];\n}\n\nconst amountNum = Number(body.amount);\nif (isNaN(amountNum) || amountNum <= 0) {\n  return [{ json: { isValid: false, validationError: 'amount must be a positive integer' } }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    params: {\n      account_id: String(body.account_id).trim(),\n      amount: amountNum,\n      currency: String(body.currency || 'USD').trim().toUpperCase(),\n      profile_id: body.profile_id && uuidRegex.test(body.profile_id) ? String(body.profile_id).trim() : null,\n      transaction_context: body.transaction_context || {}\n    }\n  }\n}];"
      },
      "id": "d46637a7-2302-433c-981c-3717457b8b29",
      "name": "Validate Request Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1200,
        208
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "payload-valid",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "24d4b853-fde2-435a-b167-3a35257c8448",
      "name": "Check Payload Validity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1008,
        208
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": {{ JSON.stringify($json.validationError) }},\n  \"code\": \"INVALID_INPUT\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "859bf198-5bbe-4142-82ab-6a705affed7e",
      "name": "Respond 400 - Invalid Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -800,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.PYTHON_SERVICE_URL }}/assess-fraud",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"account_id\": \"{{ $json.params.account_id }}\",\n  \"amount\": {{ $json.params.amount }},\n  \"currency\": \"{{ $json.params.currency }}\",\n  \"profile_id\": \"{{ $json.params.profile_id }}\",\n  \"transaction_context\": {{ JSON.stringify($json.params.transaction_context) }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "b0d95b02-6552-4bde-9d01-7609992e6e2b",
      "name": "Call Python Fraud Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -800,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nif (!item || typeof item !== 'object' || (item.approved === undefined && item.risk_score === undefined)) {\n  return [{ json: { isSchemaValid: false, error: 'Invalid response schema from Python fraud service' } }];\n}\nreturn [{\n  json: {\n    isSchemaValid: true,\n    approved: item.approved === true,\n    risk_score: item.risk_score !== undefined ? Number(item.risk_score) : 0,\n    reason: item.reason || null,\n    fraud_assessment_id: item.fraud_assessment_id || null\n  }\n}];"
      },
      "id": "ffa7914b-6723-43e4-b812-887ed0a10000",
      "name": "Validate Python Response Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        208
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "schema-valid",
              "leftValue": "={{ $json.isSchemaValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "3d7e9860-2d1d-4d8d-8cec-b628689eb2dd",
      "name": "Python Response Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -400,
        208
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"Python fraud evaluation service returned invalid schema or failed\",\n  \"details\": {{ JSON.stringify($json) }}\n}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "0f30de38-07e1-4c34-8005-71d9b589a133",
      "name": "Respond 500 - Fraud Service Error",
