    {
      "parameters": {
        "method": "POST",
        "url": "https://qesrdltnvsdkjtaastkb.supabase.co/rest/v1/rpc/place_account_hold",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_account_id\": \"{{ $('Validate Request Payload').item.json.params.account_id }}\",\n  \"p_hold_type\": \"fraud_investigation\",\n  \"p_is_full_freeze\": true,\n  \"p_amount_held\": {{ $('Validate Request Payload').item.json.params.amount }},\n  \"p_reason\": \"Deterministic fraud alert: {{ $('Validate Python Response Schema').item.json.reason || 'High risk score detected' }}\",\n  \"p_placed_by_profile_id\": {{ $('Validate Request Payload').item.json.params.profile_id ? '\"' + $('Validate Request Payload').item.json.params.profile_id + '\"' : null }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "e82be254-1ccc-4873-8413-efe9d04c8201",
      "name": "Place Account Freeze Hold RPC",
