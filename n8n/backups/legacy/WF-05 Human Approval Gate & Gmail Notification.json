        "filterType": "string",
        "filterString": "=id=eq.{{ $('Validate Approval Payload').item.json.params.draft_id }}&select=*,support_cases(*,profiles(*))"
      },
      "id": "daeafcdf-fb3d-4cb7-a3d0-8b5730c0003d",
      "name": "Fetch Draft & Case Info from Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -800,
        208
      ],
      "credentials": {
        "supabaseApi": {
          "id": "tJhpbtV5Vin0bmon",
