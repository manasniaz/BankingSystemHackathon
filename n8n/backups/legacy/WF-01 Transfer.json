        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nconst requiredFields = [\n  'source_account_id',\n  'destination_account_id',\n  'amount',\n  'currency',\n  'idempotency_key',\n  'initiated_by_profile_id',\n  'fraud_assessment_id'\n];\n\nconst missing = [];\nfor (const field of requiredFields) {\n  if (body[field] === undefined || body[field] === null || body[field] === '') {\n    missing.push(field);\n  }\n}\n\nif (missing.length > 0) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: `Missing required field(s): ${missing.join(', ')}`,\n      params: null\n    }\n  }];\n}\n\nif (!uuidRegex.test(body.source_account_id)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'source_account_id must be a valid UUID',\n      params: null\n    }\n  }];\n}\n\nif (!uuidRegex.test(body.destination_account_id)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'destination_account_id must be a valid UUID',\n      params: null\n    }\n  }];\n}\n\nif (!uuidRegex.test(body.initiated_by_profile_id)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'initiated_by_profile_id must be a valid UUID',\n      params: null\n    }\n  }];\n}\n\nif (!uuidRegex.test(body.fraud_assessment_id)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'fraud_assessment_id must be a valid UUID',\n      params: null\n    }\n  }];\n}\n\nconst amountNum = Number(body.amount);\nif (isNaN(amountNum) || amountNum <= 0 || !Number.isInteger(amountNum)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'amount must be a positive integer in minor units/cents',\n      params: null\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    params: {\n      p_source_account_id: String(body.source_account_id).trim(),\n      p_destination_account_id: String(body.destination_account_id).trim(),\n      p_amount: amountNum,\n      p_currency: String(body.currency).trim().toUpperCase(),\n      p_idempotency_key: String(body.idempotency_key).trim(),\n      p_initiated_by_profile_id: String(body.initiated_by_profile_id).trim(),\n      p_fraud_assessment_id: String(body.fraud_assessment_id).trim()\n    }\n  }\n}];"
