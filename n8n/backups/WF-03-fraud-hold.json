{
  "name": "WF-03 Fraud Assessment & Account Hold Trigger",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "assess-fraud",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-fraud",
      "name": "Webhook - Fraud Assessment Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "wf-03-fraud-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nif (!body.account_id || !uuidRegex.test(body.account_id)) {\n  return [{ json: { isValid: false, validationError: 'account_id must be a valid UUID' } }];\n}\n\nconst amountNum = Number(body.amount);\nif (isNaN(amountNum) || amountNum <= 0) {\n  return [{ json: { isValid: false, validationError: 'amount must be a positive integer' } }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    params: {\n      account_id: String(body.account_id).trim(),\n      amount: amountNum,\n      currency: String(body.currency || 'USD').trim().toUpperCase(),\n      profile_id: body.profile_id && uuidRegex.test(body.profile_id) ? String(body.profile_id).trim() : null,\n      transaction_context: body.transaction_context || {}\n    }\n  }\n}];"
      },
      "id": "node-validate-payload",
      "name": "Validate Request Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isValid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-check-validity",
      "name": "Check Payload Validity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": {{ JSON.stringify($json.validationError) }},\n  \"code\": \"INVALID_INPUT\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "node-respond-400",
      "name": "Respond 400 - Invalid Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.PYTHON_SERVICE_URL }}/assess-fraud",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"account_id\": \"{{ $json.params.account_id }}\",\n  \"amount\": {{ $json.params.amount }},\n  \"currency\": \"{{ $json.params.currency }}\",\n  \"profile_id\": \"{{ $json.params.profile_id }}\",\n  \"transaction_context\": {{ JSON.stringify($json.params.transaction_context) }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node-call-python-fraud-service",
      "name": "Call Python Fraud Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nif (!item || typeof item !== 'object' || (item.approved === undefined && item.risk_score === undefined)) {\n  return [{ json: { isSchemaValid: false, error: 'Invalid response schema from Python fraud service' } }];\n}\nreturn [{\n  json: {\n    isSchemaValid: true,\n    approved: item.approved === true,\n    risk_score: item.risk_score !== undefined ? Number(item.risk_score) : 0,\n    reason: item.reason || null,\n    fraud_assessment_id: item.fraud_assessment_id || null\n  }\n}];"
      },
      "id": "node-validate-python-response",
      "name": "Validate Python Response Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isSchemaValid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-check-python-schema",
      "name": "Python Response Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"Python fraud evaluation service returned invalid schema or failed\",\n  \"details\": {{ JSON.stringify($json) }}\n}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "node-respond-500-fraud-service-error",
      "name": "Respond 500 - Fraud Service Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.approved === false || $json.risk_score >= 75 }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-check-fraud-threshold",
      "name": "Fraud Threshold Exceeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1400,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/place_account_hold",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_account_id\": \"{{ $('Validate Request Payload').item.json.params.account_id }}\",\n  \"p_hold_type\": \"fraud_investigation\",\n  \"p_is_full_freeze\": true,\n  \"p_amount_held\": {{ $('Validate Request Payload').item.json.params.amount }},\n  \"p_reason\": \"Deterministic fraud alert: {{ $json.reason || 'High risk score detected' }}\",\n  \"p_placed_by_profile_id\": {{ $('Validate Request Payload').item.json.params.profile_id ? '\"' + $('Validate Request Payload').item.json.params.profile_id + '\"' : null }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node-place-account-hold-rpc",
      "name": "Place Account Freeze Hold RPC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"fraud_detected\": true,\n  \"hold_placed\": true,\n  \"hold_id\": {{ JSON.stringify($json) }},\n  \"fraud_assessment_id\": \"{{ $('Validate Python Response Schema').item.json.fraud_assessment_id || '' }}\",\n  \"risk_score\": {{ $('Validate Python Response Schema').item.json.risk_score || 100 }}\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-fraud-hold-placed",
      "name": "Respond 200 - Fraud Hold Placed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1800,
        100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"fraud_detected\": false,\n  \"approved\": true,\n  \"fraud_assessment_id\": \"{{ $json.fraud_assessment_id }}\",\n  \"risk_score\": {{ $json.risk_score || 0 }}\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-fraud-approved",
      "name": "Respond 200 - Fraud Assessment Approved",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1600,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook - Fraud Assessment Request": {
      "main": [
        [
          {
            "node": "Validate Request Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Request Payload": {
      "main": [
        [
          {
            "node": "Check Payload Validity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Payload Validity": {
      "main": [
        [
          {
            "node": "Call Python Fraud Service",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400 - Invalid Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Python Fraud Service": {
      "main": [
        [
          {
            "node": "Validate Python Response Schema",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Python Response Schema": {
      "main": [
        [
          {
            "node": "Python Response Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Python Response Valid?": {
      "main": [
        [
          {
            "node": "Fraud Threshold Exceeded?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 500 - Fraud Service Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fraud Threshold Exceeded?": {
      "main": [
        [
          {
            "node": "Place Account Freeze Hold RPC",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 200 - Fraud Assessment Approved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Place Account Freeze Hold RPC": {
      "main": [
        [
          {
            "node": "Respond 200 - Fraud Hold Placed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "c3d4e5f6-a7b8-49c0-d1e2-334455667788",
