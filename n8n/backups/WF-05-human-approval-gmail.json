        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"approved\": false,\n  \"email_sent\": false,\n  \"support_case_id\": \"{{ $('Verify Draft Exists & Is Pending').item.json.support_case_id }}\",\n  \"status\": \"closed\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-rejected",
      "name": "Respond 200 - Draft Rejected (No Email)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2200, 300]
    }
  ],
