            },
            {
              "fieldId": "details",
              "fieldValue": "={{ JSON.stringify({ draft_id: $('Verify Draft Exists & Is Pending').item.json.draft_id, action: 'rejected', email_sent: false }) }}"
            }
          ]
        }
      },
      "id": "node-audit-log-rejected",
      "name": "Audit Log - Draft Rejected",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2000, 300],
