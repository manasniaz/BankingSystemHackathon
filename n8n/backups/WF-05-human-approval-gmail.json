{
  "name": "WF-05 Human Approval Gate & Gmail Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "approve-draft",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-approval",
      "name": "Webhook - Human Approval Action",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "wf-05-approval-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nif (!body.draft_id || !uuidRegex.test(body.draft_id)) {\n  return [{ json: { isValid: false, validationError: 'draft_id must be a valid UUID' } }];\n}\n\nconst action = String(body.action || '').trim().toLowerCase();\nif (!['approve', 'reject', 'edit'].includes(action)) {\n  return [{ json: { isValid: false, validationError: 'action must be one of: approve, reject, edit' } }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    params: {\n      draft_id: String(body.draft_id).trim(),\n      action: action,\n      edited_draft: body.edited_draft ? String(body.edited_draft).trim() : null,\n      reviewer_profile_id: body.reviewer_profile_id && uuidRegex.test(body.reviewer_profile_id) ? String(body.reviewer_profile_id).trim() : null\n    }\n  }\n}];"
      },
      "id": "node-validate-payload",
      "name": "Validate Approval Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "payload-valid",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "node-check-validity",
      "name": "Check Input Validity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": {{ JSON.stringify($json.validationError) }},\n  \"code\": \"INVALID_INPUT\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "node-respond-400",
      "name": "Respond 400 - Invalid Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [800, 500]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "support_case_drafts",
        "returnAll": false,
        "limit": 1,
        "filterType": "string",
        "filterString": "id=eq.{{ $json.params.draft_id }}&select=*,support_cases(*,profiles(*))"
      },
      "id": "node-fetch-draft-and-case",
      "name": "Fetch Draft & Case Info from Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [800, 300],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const records = $input.all();\nif (!records || records.length === 0 || !records[0].json.id) {\n  return [{ json: { isPending: false, error: 'Draft record not found in Supabase' } }];\n}\n\nconst draft = records[0].json;\nif (draft.human_review_state !== 'pending') {\n  return [{ json: { isPending: false, error: `Draft has already been processed with state: ${draft.human_review_state}` } }];\n}\n\nconst supportCase = draft.support_cases;\nif (!supportCase) {\n  return [{ json: { isPending: false, error: 'Associated support case not found' } }];\n}\n\nconst customerEmail = supportCase.profiles ? supportCase.profiles.email : (supportCase.customer_email || null);\nif (!customerEmail) {\n  return [{ json: { isPending: false, error: 'No trusted customer email found on support case profile' } }];\n}\n\nreturn [{\n  json: {\n    isPending: true,\n    draft_id: draft.id,\n    support_case_id: draft.support_case_id,\n    customer_email: customerEmail,\n    subject: supportCase.subject || 'Support Inquiry',\n    stored_groq_draft: draft.groq_draft,\n    action: $('Validate Approval Payload').item.json.params.action,\n    edited_draft: $('Validate Approval Payload').item.json.params.edited_draft,\n    reviewer_profile_id: $('Validate Approval Payload').item.json.params.reviewer_profile_id\n  }\n}];"
      },
      "id": "node-verify-pending-draft",
      "name": "Verify Draft Exists & Is Pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "is-pending",
              "leftValue": "={{ $json.isPending }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "node-check-pending-status",
      "name": "Is Draft Pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": {{ JSON.stringify($json.error) }},\n  \"code\": \"INVALID_STATE_OR_NOT_FOUND\"\n}",
        "options": {
          "responseCode": 409
        }
      },
      "id": "node-respond-409-conflict",
      "name": "Respond 409 - Invalid State or Not Found",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 500]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "action-approve",
              "leftValue": "={{ $json.action === 'approve' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "action-edit",
              "leftValue": "={{ $json.action === 'edit' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "node-check-approval-action",
      "name": "Action Approved or Edited?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1400, 200]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "support_case_drafts",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.draft_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "human_review_state",
              "fieldValue": "={{ $json.action === 'edit' ? 'edited' : 'approved' }}"
            },
            {
              "fieldId": "groq_draft",
              "fieldValue": "={{ $json.edited_draft || $json.stored_groq_draft }}"
            }
          ]
        }
      },
      "id": "node-update-draft-approved",
      "name": "Update Draft State - Approved",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1600, 100],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "support_cases",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Verify Draft Exists & Is Pending').item.json.support_case_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "resolved"
            },
            {
              "fieldId": "final_sent_response",
              "fieldValue": "={{ $('Verify Draft Exists & Is Pending').item.json.edited_draft || $('Verify Draft Exists & Is Pending').item.json.stored_groq_draft }}"
            }
          ]
        }
      },
      "id": "node-update-case-resolved",
      "name": "Update Case Status - Resolved",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1800, 100],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "emailType": "text",
        "sendTo": "={{ $('Verify Draft Exists & Is Pending').item.json.customer_email }}",
        "subject": "=RE: {{ $('Verify Draft Exists & Is Pending').item.json.subject }}",
        "message": "={{ $('Verify Draft Exists & Is Pending').item.json.edited_draft || $('Verify Draft Exists & Is Pending').item.json.stored_groq_draft }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "node-send-gmail",
      "name": "Send Customer Email via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [2000, 100],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "audit_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "event_type",
              "fieldValue": "support_case_resolved"
            },
            {
              "fieldId": "actor_type",
              "fieldValue": "n8n"
            },
            {
              "fieldId": "actor_id",
              "fieldValue": "={{ $('Verify Draft Exists & Is Pending').item.json.reviewer_profile_id || null }}"
            },
            {
              "fieldId": "target_type",
              "fieldValue": "support_case"
            },
            {
              "fieldId": "target_id",
              "fieldValue": "={{ $('Verify Draft Exists & Is Pending').item.json.support_case_id }}"
            },
            {
              "fieldId": "details",
              "fieldValue": "={{ JSON.stringify({ draft_id: $('Verify Draft Exists & Is Pending').item.json.draft_id, action: $('Verify Draft Exists & Is Pending').item.json.action, email_sent: true }) }}"
            }
          ]
        }
      },
      "id": "node-audit-log-approved",
      "name": "Audit Log - Case Approved & Sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2200, 100],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"approved\": true,\n  \"email_sent\": true,\n  \"support_case_id\": \"{{ $('Verify Draft Exists & Is Pending').item.json.support_case_id }}\",\n  \"status\": \"resolved\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-approved",
      "name": "Respond 200 - Approved & Email Sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2400, 100]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "support_case_drafts",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
