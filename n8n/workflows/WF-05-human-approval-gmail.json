    {
      "parameters": {
        "jsCode": "const records = $input.all();\nif (!records || records.length === 0 || !records[0].json.id) {\n  return [{ json: { isPending: false, error: 'Draft record not found in Supabase' } }];\n}\n\nconst draft = records[0].json;\nif (draft.human_review_state !== 'pending') {\n  return [{ json: { isPending: false, error: `Draft has already been processed with state: ${draft.human_review_state}` } }];\n}\n\nconst supportCase = draft.support_cases;\nif (!supportCase) {\n  return [{ json: { isPending: false, error: 'Associated support case not found' } }];\n}\n\nconst customerEmail = supportCase.profiles ? supportCase.profiles.email : (supportCase.customer_email || null);\nif (!customerEmail) {\n  return [{ json: { isPending: false, error: 'No trusted customer email found on support case profile' } }];\n}\n\nreturn [{\n  json: {\n    isPending: true,\n    draft_id: draft.id,\n    support_case_id: draft.support_case_id,\n    customer_email: customerEmail,\n    subject: supportCase.subject || 'Support Inquiry',\n    stored_groq_draft: draft.groq_draft,\n    action: $('Validate Approval Payload').item.json.params.action,\n    edited_draft: $('Validate Approval Payload').item.json.params.edited_draft,\n    reviewer_profile_id: $('Validate Approval Payload').item.json.params.reviewer_profile_id\n  }\n}];"
      },
