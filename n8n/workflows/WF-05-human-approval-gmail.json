    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nif (!body.draft_id || !uuidRegex.test(body.draft_id)) {\n  return [{ json: { isValid: false, validationError: 'draft_id must be a valid UUID' } }];\n}\n\nconst action = String(body.action || '').trim().toLowerCase();\nif (!['approve', 'reject', 'edit'].includes(action)) {\n  return [{ json: { isValid: false, validationError: 'action must be one of: approve, reject, edit' } }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    params: {\n      draft_id: String(body.draft_id).trim(),\n      action: action,\n      edited_draft: body.edited_draft ? String(body.edited_draft).trim() : null,\n      reviewer_profile_id: body.reviewer_profile_id && uuidRegex.test(body.reviewer_profile_id) ? String(body.reviewer_profile_id).trim() : null\n    }\n  }\n}];"
      },
