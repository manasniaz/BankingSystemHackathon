        "filterType": "string",
        "filterString": "=id=eq.{{ $('Validate Approval Payload').item.json.params.draft_id }}&select=*,support_cases(*,profiles(*))"
      },
      "id": "626e77c5-3493-4a06-b28e-b460d5f83d09",
      "name": "Fetch Draft & Case Info from Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -1312,
        32
      ],
      "credentials": {
        "supabaseApi": {
