    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst body = inputData.body || inputData;\n\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\n// Default placeholder fraud assessment for safe execution if not provided\nconst defaultFraudId = 'fa000000-0000-0000-0000-000000000001';\n\nconst sourceAccount = body.source_account_id || 'aa000000-0000-0000-0000-000000000001';\nconst destAccount = body.destination_account_id || 'bb000000-0000-0000-0000-000000000002';\nconst profileId = body.initiated_by_profile_id || 'a0000000-0000-0000-0000-000000000001';\nconst idempotencyKey = body.idempotency_key || `tx_${Date.now()}`;\nconst fraudAssessmentId = body.fraud_assessment_id || defaultFraudId;\n\nconst amountNum = Number(body.amount);\nif (isNaN(amountNum) || amountNum <= 0) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'amount must be a positive integer in minor units/cents',\n      params: null\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    params: {\n      p_source_account_id: String(sourceAccount).trim(),\n      p_destination_account_id: String(destAccount).trim(),\n      p_amount: amountNum,\n      p_currency: String(body.currency || 'USD').trim().toUpperCase(),\n      p_idempotency_key: String(idempotencyKey).trim(),\n      p_initiated_by_profile_id: String(profileId).trim(),\n      p_fraud_assessment_id: String(fraudAssessmentId).trim()\n    }\n  }\n}];"
      },
