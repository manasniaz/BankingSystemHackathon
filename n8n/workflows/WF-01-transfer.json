      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst body = inputData.body || inputData;\n\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\n// SECURITY: No hardcoded fallbacks. Every field must be supplied by the caller.\n// A missing field is a rejected request, never a default account.\nconst required = {\n  source_account_id: body.source_account_id,\n  destination_account_id: body.destination_account_id,\n  initiated_by_profile_id: body.initiated_by_profile_id,\n  fraud_assessment_id: body.fraud_assessment_id,\n  idempotency_key: body.idempotency_key\n};\n\nconst missing = [];\nObject.keys(required).forEach(k => {\n  if (!required[k] || String(required[k]).trim() === '') missing.push(k);\n});\n\nif (missing.length > 0) {\n  return [{ json: { isValid: false, validationError: 'Missing required field(s): ' + missing.join(', '), params: null } }];\n}\n\nconst uuidFields = ['source_account_id', 'destination_account_id', 'initiated_by_profile_id', 'fraud_assessment_id'];\nfor (const f of uuidFields) {\n  if (!uuidRegex.test(String(required[f]).trim())) {\n    return [{ json: { isValid: false, validationError: f + ' must be a valid UUID', params: null } }];\n  }\n}\n\nif (String(required.source_account_id).trim() === String(required.destination_account_id).trim()) {\n  return [{ json: { isValid: false, validationError: 'Source and destination accounts must be different', params: null } }];\n}\n\nconst amountNum = Number(body.amount);\nif (isNaN(amountNum) || amountNum <= 0 || !Number.isInteger(amountNum)) {\n  return [{ json: { isValid: false, validationError: 'amount must be a positive integer in minor units (paisa)', params: null } }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    params: {\n      p_source_account_id: String(required.source_account_id).trim(),\n      p_destination_account_id: String(required.destination_account_id).trim(),\n      p_amount: amountNum,\n      p_currency: String(body.currency || 'PKR').trim().toUpperCase(),\n      p_idempotency_key: String(required.idempotency_key).trim(),\n      p_initiated_by_profile_id: String(required.initiated_by_profile_id).trim(),\n      p_fraud_assessment_id: String(required.fraud_assessment_id).trim()\n    }\n  }\n}];"
      },
