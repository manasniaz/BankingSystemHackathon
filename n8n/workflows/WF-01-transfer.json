{
  "name": "WF-01 Transfer",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "transfer",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-transfer",
      "name": "Webhook - Transfer Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "wf-01-transfer-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nconst requiredFields = [\n  'source_account_id',\n  'destination_account_id',\n  'amount',\n  'currency',\n  'idempotency_key',\n  'initiated_by_profile_id',\n  'fraud_assessment_id'\n];\n\nconst missing = [];\nfor (const field of requiredFields) {\n  if (body[field] === undefined || body[field] === null || body[field] === '') {\n    missing.push(field);\n  }\n}\n\nif (missing.length > 0) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: `Missing required field(s): ${missing.join(', ')}`,\n      params: null\n    }\n  }];\n}\n\nif (!uuidRegex.test(body.source_account_id)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'source_account_id must be a valid UUID',\n      params: null\n    }\n  }];\n}\n\nif (!uuidRegex.test(body.destination_account_id)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'destination_account_id must be a valid UUID',\n      params: null\n    }\n  }];\n}\n\nif (!uuidRegex.test(body.initiated_by_profile_id)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'initiated_by_profile_id must be a valid UUID',\n      params: null\n    }\n  }];\n}\n\nif (!uuidRegex.test(body.fraud_assessment_id)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'fraud_assessment_id must be a valid UUID',\n      params: null\n    }\n  }];\n}\n\nconst amountNum = Number(body.amount);\nif (isNaN(amountNum) || amountNum <= 0 || !Number.isInteger(amountNum)) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'amount must be a positive integer in minor units/cents',\n      params: null\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    params: {\n      p_source_account_id: String(body.source_account_id).trim(),\n      p_destination_account_id: String(body.destination_account_id).trim(),\n      p_amount: amountNum,\n      p_currency: String(body.currency).trim().toUpperCase(),\n      p_idempotency_key: String(body.idempotency_key).trim(),\n      p_initiated_by_profile_id: String(body.initiated_by_profile_id).trim(),\n      p_fraud_assessment_id: String(body.fraud_assessment_id).trim()\n    }\n  }\n}];"
      },
      "id": "node-validate-payload",
      "name": "Validate Request Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isValid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-check-validity",
      "name": "Check Input Validity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": {{ JSON.stringify($json.validationError) }},\n  \"code\": \"INVALID_INPUT\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "node-respond-400",
      "name": "Respond 400 - Invalid Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/execute_transfer",
        "authentication": "genericCredentialType",
        "genericCredentialType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_source_account_id\": \"{{ $json.params.p_source_account_id }}\",\n  \"p_destination_account_id\": \"{{ $json.params.p_destination_account_id }}\",\n  \"p_amount\": {{ $json.params.p_amount }},\n  \"p_currency\": \"{{ $json.params.p_currency }}\",\n  \"p_idempotency_key\": \"{{ $json.params.p_idempotency_key }}\",\n  \"p_initiated_by_profile_id\": \"{{ $json.params.p_initiated_by_profile_id }}\",\n  \"p_fraud_assessment_id\": \"{{ $json.params.p_fraud_assessment_id }}\"\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node-execute-rpc",
      "name": "Execute Supabase RPC execute_transfer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "supabase-service-role-custom-auth",
          "name": "Supabase Service Role Credential"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.success === true }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-check-rpc-result",
      "name": "Check RPC Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.success === false || ($json.statusCode >= 400 && $json.statusCode < 500) || typeof $json.error === 'string' }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-check-error-type",
      "name": "Check Error Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1200,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-200",
      "name": "Respond 200 - Transfer Successful",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.error ? { \"success\": false, \"error\": $json.error, \"idempotency_key\": $json.idempotency_key } : ($json.message ? { \"success\": false, \"error\": $json.message } : { \"success\": false, \"error\": \"Transfer rejected by banking business rules\" })) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "node-respond-422",
      "name": "Respond 422 - Business Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1400,
        360
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"Internal infrastructure failure or RPC execution error\",\n  \"details\": {{ JSON.stringify($json) }}\n}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "node-respond-500",
      "name": "Respond 500 - System Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1400,
        540
      ]
    }
  ],
  "pinData": {},
  "connections": {
