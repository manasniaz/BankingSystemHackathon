      "credentials": {
        "supabaseApi": {
          "id": "tJhpbtV5Vin0bmon",
          "name": "Supabase account"
        }
      },
      "notes": "A reversal that could not be fully clawed back leaves a debt. This collects it from whatever the account holds, without ever pushing the balance below zero. Runs nightly so a debtor who receives money today pays it down tonight."
    },
    {
      "id": "s11-0008-4aaa-9008-aaaaaaaaaaa8",
      "name": "Accrue Monthly Interest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        480
      ],
      "parameters": {
        "method": "POST",
        "url": "https://qesrdltnvsdkjtaastkb.supabase.co/rest/v1/rpc/accrue_monthly_interest",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_as_of: null }) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "tJhpbtV5Vin0bmon",
          "name": "Supabase account"
        }
      },
      "notes": "Safe to run every night even though interest is monthly: the accrual is keyed on (account_id, period_start) with a unique constraint, so only the first run after a month ends pays anything and every later run that month reports the accounts it skipped."
    },
    {
      "parameters": {
        "jsCode": "// Every nightly RPC here runs with neverError: true, so a failure arrives as\n// DATA shaped like a normal response instead of stopping the workflow. Only\n// run_reconciliation's result was ever inspected. The rest could fail every\n// night and the first symptom would be a customer noticing.\n//\n// Read through $('Node').first().json rather than $json: this node sits at the\n// end of a chain, so $json is only ever the LAST rpc's response.\nconst CHECKS = [\n  ['promote_minors_to_adult', 'Execute Supabase RPC promote_minors_to_adult'],\n  ['expire_stale_ops_approvals', 'Expire Stale Ops Approvals'],\n  ['expire_stale_minor_account_requests', 'Expire Stale Guardian Requests'],\n  ['sweep_outstanding_debts', 'Sweep Outstanding Debts'],\n  ['accrue_monthly_interest', 'Accrue Monthly Interest']\n];\n\nfunction resultOf(nodeName) {\n  try {\n    return $(nodeName).first().json || {};\n  } catch (e) {\n    // A node that never ran is itself a failure worth reporting: it means the\n    // chain broke upstream and the later jobs silently did not happen.\n    return { __unreachable: String(e).slice(0, 200) };\n  }\n}\n\nconst failures = [];\nfor (const pair of CHECKS) {\n  const rpc = pair[0];\n  const result = resultOf(pair[1]);\n\n  if (result.__unreachable) {\n    failures.push(rpc + ' -- did not run: ' + result.__unreachable);\n    continue;\n  }\n  // PostgREST reports a failure as {code, message, details, hint}. A healthy\n  // RPC return value never carries `message` at the top level.\n  if (result.code || result.message) {\n    failures.push(rpc + ' -- ' + (result.message || result.code) +\n                  (result.hint ? ' (hint: ' + result.hint + ')' : ''));\n  } else if (result.success === false) {\n    failures.push(rpc + ' -- ' + (result.error || 'returned success: false'));\n  }\n}\n\nreturn [{ json: {\n  anyFailed: failures.length > 0,\n  failureCount: failures.length,\n  failures: failures.join('\\n'),\n  checked: CHECKS.length\n} }];"
      },
      "id": "7e1c9a52-3b84-4d17-a0f6-91cbb2e4d5a8",
