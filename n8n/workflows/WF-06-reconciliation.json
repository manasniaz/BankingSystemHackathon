      "parameters": {
        "method": "POST",
        "url": "https://qesrdltnvsdkjtaastkb.supabase.co/rest/v1/rpc/sweep_outstanding_debts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
