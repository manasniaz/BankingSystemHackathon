{
  "name": "WF-02 Standing Order Scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "id": "1ae38aa8-aecc-42f3-84d4-599709982637",
      "name": "Schedule - Hourly Standing Order Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -624,
        64
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "standing_orders",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=status=eq.active&next_execution_at=lte.{{ $now.toISO() }}&select=id,source_account_id,destination_account_id,amount,currency,frequency,next_execution_at,retry_count,last_error,status"
      },
      "id": "0f01dbc3-ad24-4611-9da5-94404c79d867",
      "name": "Fetch Due Standing Orders",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -416,
        64
      ],
      "credentials": {
        "supabaseApi": {
          "id": "tJhpbtV5Vin0bmon",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "orders-exist",
              "leftValue": "={{ Array.isArray($input.all()) && $input.all().length > 0 && !!$input.first().json.id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "21ac3617-f16f-4b2a-b618-9fc4bcff51ed",
      "name": "Any Orders Due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -224,
        64
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "5984bc86-5215-42ab-9e7c-98d74c053ed8",
      "name": "Process Orders One By One",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -16,
        -48
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://qesrdltnvsdkjtaastkb.supabase.co/rest/v1/rpc/execute_standing_order",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_standing_order_id\": \"{{ $json.id }}\"\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "da71f762-94c8-44f3-a1ec-58460e17ff30",
      "name": "Execute Supabase RPC execute_standing_order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        192,
        -48
      ],
      "credentials": {
        "supabaseApi": {
          "id": "tJhpbtV5Vin0bmon",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "exec-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "fd480f0f-ad34-41a4-ad3f-00412299ac9f",
      "name": "Check Execution Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        384,
        -48
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "perm-failed",
              "leftValue": "={{ $json.status === 'failed' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "max-retries",
              "leftValue": "={{ $json.retry_count !== undefined && $json.retry_count >= 3 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "9d6b76db-d62f-4495-8ede-cd1061ffa8bc",
      "name": "Permanent Failure?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        592,
        80
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "alert_msg",
              "name": "alert_summary",
              "type": "string",
              "value": "=CRITICAL: Standing order {{ $json.standing_order_id || 'unknown' }} failed permanently after {{ $json.retry_count || 3 }} retries. Reason: {{ $json.error || 'Unknown error' }}"
            },
            {
              "id": "standing_order_id",
              "name": "standing_order_id",
              "type": "string",
              "value": "={{ $json.standing_order_id }}"
            },
            {
              "id": "error_reason",
              "name": "error",
              "type": "string",
              "value": "={{ $json.error }}"
            }
          ]
        },
        "options": {}
      },
      "id": "d2cb46e7-ca4f-48e7-a258-d5ac23bc0824",
      "name": "Format Permanent Failure Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        784,
        80
      ]
    },
    {
      "parameters": {
        "sendTo": "metonystar1@gmail.com",
        "subject": "={{ \"ALERT: Standing Order Permanently Failed\" }}",
        "emailType": "text",
        "message": "={{ \"Standing Order Permanent Failure Alert\\n\\n\" + $json.alert_summary + \"\\n\\nStanding Order ID: \" + ($json.standing_order_id || \"unknown\") + \"\\nError: \" + ($json.error || \"Unknown\") + \"\\n\\nThis standing order has been permanently disabled after 3 failed retry attempts.\" }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "6215ce37-0fe2-4721-abb3-487b99c25f25",
      "name": "Email Ops Team - Standing Order Failed",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        992,
        80
      ],
      "webhookId": "dfed9d43-b9de-4d01-ae43-ce89d26dd747",
      "credentials": {
        "gmailOAuth2": {
          "id": "IrWmPXzOkHIt9fdU",
          "name": "Gmail account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule - Hourly Standing Order Check": {
      "main": [
