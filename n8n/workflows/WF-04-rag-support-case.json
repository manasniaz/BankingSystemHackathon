{
  "name": "WF-04 RAG Support Case Handling",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-case",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-support",
      "name": "Webhook - New Support Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "wf-04-support-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nif (!body.profile_id || !uuidRegex.test(body.profile_id)) {\n  return [{ json: { isValid: false, validationError: 'profile_id must be a valid UUID' } }];\n}\nif (!body.subject || typeof body.subject !== 'string' || body.subject.trim() === '') {\n  return [{ json: { isValid: false, validationError: 'subject is required' } }];\n}\nif (!body.inquiry || typeof body.inquiry !== 'string' || body.inquiry.trim() === '') {\n  return [{ json: { isValid: false, validationError: 'inquiry text is required' } }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    params: {\n      profile_id: String(body.profile_id).trim(),\n      customer_email: body.customer_email ? String(body.customer_email).trim() : null,\n      subject: String(body.subject).trim(),\n      inquiry: String(body.inquiry).trim()\n    }\n  }\n}];"
      },
      "id": "node-validate-payload",
      "name": "Validate Support Request Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "payload-valid",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "node-check-validity",
      "name": "Check Payload Validity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": {{ JSON.stringify($json.validationError) }},\n  \"code\": \"INVALID_INPUT\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "node-respond-400",
      "name": "Respond 400 - Invalid Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [800, 500]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "support_cases",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "profile_id",
              "fieldValue": "={{ $json.params.profile_id }}"
            },
            {
              "fieldId": "subject",
              "fieldValue": "={{ $json.params.subject }}"
            },
            {
              "fieldId": "inquiry",
              "fieldValue": "={{ $json.params.inquiry }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "open"
            }
          ]
        }
      },
      "id": "node-create-support-case",
      "name": "Create Support Case in Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [800, 300],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract the created case ID from the Supabase node response.\n// The Supabase create node returns the inserted row directly as json.\nconst caseRow = $input.first().json;\nconst caseId = caseRow.id || (Array.isArray(caseRow) ? caseRow[0]?.id : null);\nconst validatedParams = $('Validate Support Request Payload').item.json.params;\n\nreturn [{\n  json: {\n    case_id: caseId,\n    profile_id: validatedParams.profile_id,\n    subject: validatedParams.subject,\n    inquiry: validatedParams.inquiry,\n    customer_email: validatedParams.customer_email\n  }\n}];"
      },
      "id": "node-extract-case-id",
      "name": "Extract Case ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.inquiry }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a professional banking customer support drafting assistant. Use the Policy Knowledge Base tool to find relevant banking policy before composing any response.\n\nSTRICT RULES:\n(1) Only state policies, fees, timelines, limits, or procedures that appear explicitly in retrieved Policy Knowledge Base documents.\n(2) Historical resolved cases from Pinecone may guide tone and format ONLY — never treat a past case response as authoritative policy.\n(3) If retrieved policy does not clearly and directly cover the customer's question, set grounded=false, needs_human=true, and write a draft that says the query is being escalated to a specialist. NEVER invent banking rules.\n(4) Always list the doc_ids you used in the citations array.\n(5) Set confidence between 0.0 and 1.0 reflecting how completely the retrieved policy covers the customer question.\n(6) Draft a polite, professional email response for human review only — no draft is ever sent automatically.\n\nReturn ONLY a structured JSON object with: draft (string), grounded (boolean), confidence (number 0-1), citations (array of doc_id strings), needs_human (boolean)."
        }
      },
      "id": "node-draft-grounded-reply",
      "name": "Draft Grounded Reply",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "temperature": 0.1
        }
      },
      "id": "node-groq-model",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [1100, 500],
      "credentials": {
        "groqApi": {
          "id": "",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search official banking policy documents (wire transfer limits, fees, overdraft rules, hold policies, dispute rights, international transfer procedures). Only use facts returned here. NEVER invent banking policy, limits, fees, or procedures.",
        "pineconeIndex": {
          "__rl": true,
          "value": "banking-policy-index",
          "mode": "id"
        },
        "options": {
          "pineconeNamespace": "banking_policy"
        }
      },
      "id": "node-policy-knowledge-base",
      "name": "Policy Knowledge Base",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [1300, 520],
      "credentials": {
        "pineconeApi": {
          "id": "",
          "name": "Pinecone account"
        }
      }
    },
    {
      "parameters": {},
      "id": "node-gemini-embeddings",
      "name": "Gemini Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [1300, 660],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) API"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"draft\": \"The full customer reply text, grounded only in retrieved policy.\",\n  \"grounded\": true,\n  \"confidence\": 0.0,\n  \"citations\": [\n    \"doc_id_1\",\n    \"doc_id_2\"\n  ],\n  \"needs_human\": false\n}"
      },
      "id": "node-draft-parser",
      "name": "Draft Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [1450, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "grounded",
              "leftValue": "={{ $json.output.grounded }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "needs-human-false",
              "leftValue": "={{ $json.output.needs_human }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "confidence-threshold",
              "leftValue": "={{ $json.output.confidence }}",
              "rightValue": 0.7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "has-citations",
              "leftValue": "={{ $json.output.citations.length }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        }
      },
      "id": "node-grounded-and-confident",
      "name": "Grounded & Confident? (>= 0.7)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "groq-draft",
              "name": "groq_draft",
              "type": "string",
              "value": "={{ $json.output.draft }}"
            },
            {
              "id": "citations",
              "name": "citations",
              "type": "array",
              "value": "={{ $json.output.citations }}"
            },
            {
              "id": "confidence",
              "name": "confidence_score",
              "type": "number",
              "value": "={{ $json.output.confidence }}"
            },
            {
              "id": "grounded",
              "name": "grounded",
              "type": "boolean",
              "value": "={{ $json.output.grounded }}"
            },
            {
              "id": "threshold-exceeded",
              "name": "threshold_exceeded",
              "type": "boolean",
              "value": true
            }
          ]
        },
        "options": {}
      },
      "id": "node-format-grounded-draft",
      "name": "Format Grounded Draft",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1850, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fallback-draft",
              "name": "groq_draft",
              "type": "string",
              "value": "=Thank you for contacting bank support regarding: \"{{ $('Extract Case ID').item.json.subject }}\". Your inquiry requires specialist verification. Our customer support team has received your request and a specialist will respond shortly."
            },
            {
              "id": "citations",
              "name": "citations",
              "type": "array",
              "value": "=[]"
            },
            {
              "id": "confidence",
              "name": "confidence_score",
              "type": "number",
              "value": "={{ $json.output.confidence || 0 }}"
            },
            {
              "id": "grounded",
              "name": "grounded",
              "type": "boolean",
              "value": false
            },
            {
              "id": "threshold-exceeded",
              "name": "threshold_exceeded",
              "type": "boolean",
              "value": false
            }
          ]
        },
        "options": {}
      },
      "id": "node-fallback-draft",
      "name": "Insufficient Policy Fallback Draft",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1850, 400]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "support_case_drafts",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "support_case_id",
              "fieldValue": "={{ $('Extract Case ID').item.json.case_id }}"
            },
            {
              "fieldId": "rag_doc_ids",
              "fieldValue": "={{ JSON.stringify($json.citations) }}"
            },
            {
              "fieldId": "similarity_scores",
              "fieldValue": "=[]"
            },
            {
              "fieldId": "confidence_score",
              "fieldValue": "={{ $json.confidence_score }}"
            },
            {
              "fieldId": "threshold_exceeded",
              "fieldValue": "={{ $json.threshold_exceeded }}"
            },
            {
              "fieldId": "groq_draft",
              "fieldValue": "={{ $json.groq_draft }}"
            },
            {
              "fieldId": "human_review_state",
              "fieldValue": "pending"
            }
          ]
        }
      },
      "id": "node-save-support-case-draft",
      "name": "Save Support Case Draft in Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2050, 300],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "support_cases",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Extract Case ID').item.json.case_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "awaiting_human_review"
            }
          ]
        }
      },
      "id": "node-update-case-status",
      "name": "Update Case Status to Awaiting Review",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2250, 300],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"support_case_id\": \"{{ $('Extract Case ID').item.json.case_id }}\",\n  \"status\": \"awaiting_human_review\",\n  \"threshold_exceeded\": {{ $('Grounded & Confident? (>= 0.7)').item.json.threshold_exceeded || false }},\n  \"confidence_score\": {{ $('Grounded & Confident? (>= 0.7)').item.json.confidence_score || 0 }}\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-200-case-created",
      "name": "Respond 200 - Case Created & Draft Saved",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2450, 300]
    }
  ],
