      "id": "1dbca59b-c13c-44a8-9225-e00d54441921",
      "name": "Webhook - New Support Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        208
      ],
      "webhookId": "wf-04-support-webhook"
