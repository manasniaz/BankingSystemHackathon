    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst body = inputData.body || inputData;\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nconst profileId = body.profile_id || 'a0000000-0000-0000-0000-000000000001';\nconst subject = body.subject || 'General Banking Inquiry';\nconst inquiry = body.inquiry || body.bodyText || 'What are the bank policies?';\nconst customerEmail = body.customer_email || 'customer@test.banking';\n\nreturn [{\n  json: {\n    isValid: true,\n    params: {\n      profile_id: String(profileId).trim(),\n      customer_email: String(customerEmail).trim(),\n      subject: String(subject).trim(),\n      inquiry: String(inquiry).trim()\n    }\n  }\n}];"
      },
      "id": "e689ceab-983e-4bfa-927c-52ee4b9cbf6a",
      "name": "Validate Support Request Payload",
