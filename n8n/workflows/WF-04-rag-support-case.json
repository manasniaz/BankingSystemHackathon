    {
      "parameters": {
        "jsCode": "const caseRow = $input.first().json;\nconst caseId = caseRow.id || (Array.isArray(caseRow) ? caseRow[0]?.id : `case_${Date.now()}`);\nconst params = $('Validate Support Request Payload').item.json.params;\n\nreturn [{\n  json: {\n    case_id: caseId,\n    profile_id: params.profile_id,\n    subject: params.subject,\n    inquiry: params.inquiry,\n    customer_email: params.customer_email\n  }\n}];"
      },
      "id": "bd9e5ea1-6cc4-401e-b1a5-caa6f31ac2d6",
      "name": "Extract Case ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1080,
        100
      ]
