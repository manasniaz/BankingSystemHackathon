    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst body = inputData.body || inputData;\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nconst accountId = body.account_id || 'aa000000-0000-0000-0000-000000000001';\nconst amountNum = Number(body.amount) || 1000;\n\nreturn [{\n  json: {\n    isValid: true,\n    params: {\n      account_id: String(accountId).trim(),\n      amount: amountNum,\n      currency: String(body.currency || 'USD').trim().toUpperCase(),\n      profile_id: body.profile_id ? String(body.profile_id).trim() : null,\n      transaction_context: body.transaction_context || {}\n    }\n  }\n}];"
      },
      "id": "d46637a7-2302-433c-981c-3717457b8b29",
      "name": "Validate Request Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1200,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.PYTHON_SERVICE_URL || 'http://localhost:8080' }}/assess-fraud",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"account_id\": \"{{ $json.params.account_id }}\",\n  \"amount\": {{ $json.params.amount }},\n  \"currency\": \"{{ $json.params.currency }}\",\n  \"profile_id\": \"{{ $json.params.profile_id }}\",\n  \"transaction_context\": {{ JSON.stringify($json.params.transaction_context) }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "b0d95b02-6552-4bde-9d01-7609992e6e2b",
      "name": "Call Python Fraud Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -960,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Safety rule: NEVER silently approve if fraud service fails\nif (!item || typeof item !== 'object' || item.error || (item.approved === undefined && item.risk_score === undefined)) {\n  return [{\n    json: {\n      isSchemaValid: false,\n      approved: false,\n      risk_score: 100.0,\n      decision: 'HOLD',\n      reason: 'Python fraud service unavailable or returned invalid schema (Safety Lock triggered)',\n      fraud_assessment_id: null\n    }\n  }];\n}\n\nconst riskScore = Number(item.risk_score || 0);\nconst approved = item.approved === true && riskScore < 75;\nlet decision = 'CLEAR';\nif (riskScore >= 75 || !approved) {\n  decision = 'HOLD';\n} else if (riskScore >= 40) {\n  decision = 'REVIEW';\n}\n\nreturn [{\n  json: {\n    isSchemaValid: true,\n    approved,\n    risk_score: riskScore,\n    decision,\n    reason: item.reason || 'Fraud assessment complete',\n    fraud_assessment_id: item.fraud_assessment_id || 'fa000000-0000-0000-0000-000000000001'\n  }\n}];"
      },
      "id": "ffa7914b-6723-43e4-b812-887ed0a10000",
      "name": "Validate & Evaluate Fraud Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "hold-decision",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "HOLD",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "not-approved",
              "leftValue": "={{ $json.approved }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
