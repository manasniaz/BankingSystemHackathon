    {
      "parameters": {
        "httpMethod": "POST",
        "path": "assess-fraud",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "79bffddc-e6aa-4fa7-89fb-20918ba2efb9",
      "name": "Webhook - Fraud Assessment Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        208
      ],
      "webhookId": "wf-03-fraud-webhook"
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst body = inputData.body || inputData;\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nconst accountId = body.account_id || 'aa000000-0000-0000-0000-000000000001';\nconst amountNum = Number(body.amount) || 1000;\n\nreturn [{\n  json: {\n    isValid: true,\n    params: {\n      account_id: String(accountId).trim(),\n      amount: amountNum,\n      currency: String(body.currency || 'USD').trim().toUpperCase(),\n      profile_id: body.profile_id ? String(body.profile_id).trim() : null,\n      transaction_context: body.transaction_context || {}\n    }\n  }\n}];"
      },
      "id": "ae99bab2-53ca-4424-b03b-4a4ae7b62664",
      "name": "Validate Request Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://' + ($vars.PYTHON_SERVICE_URL || 'bankingsystemhackathon-production.up.railway.app').replace(/^https?:\\/\\//, '') }}/assess-fraud",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"account_id\": \"{{ $json.params.account_id }}\",\n  \"amount\": {{ $json.params.amount }},\n  \"currency\": \"{{ $json.params.currency }}\",\n  \"profile_id\": \"{{ $json.params.profile_id }}\",\n  \"transaction_context\": {{ JSON.stringify($json.params.transaction_context) }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "60f791fc-4fee-456e-85d6-8c63c4a12c6b",
      "name": "Call Python Fraud Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Safety rule: NEVER silently approve if fraud service fails\nif (!item || typeof item !== 'object' || item.error || (item.approved === undefined && item.risk_score === undefined)) {\n  return [{\n    json: {\n      isSchemaValid: false,\n      approved: false,\n      risk_score: 100.0,\n      decision: 'HOLD',\n      reason: 'Python fraud service unavailable or returned invalid schema (Safety Lock triggered)',\n      fraud_assessment_id: null\n    }\n  }];\n}\n\nconst riskScore = Number(item.risk_score || 0);\nconst approved = item.approved === true && riskScore < 75;\nlet decision = 'CLEAR';\nif (riskScore >= 75 || !approved) {\n  decision = 'HOLD';\n} else if (riskScore >= 40) {\n  decision = 'REVIEW';\n}\n\nreturn [{\n  json: {\n    isSchemaValid: true,\n    approved,\n    risk_score: riskScore,\n    decision,\n    reason: item.reason || 'Fraud assessment complete',\n    fraud_assessment_id: item.fraud_assessment_id || 'fa000000-0000-0000-0000-000000000001'\n  }\n}];"
      },
      "id": "25c82937-4bae-47b1-b006-7cc228942d9f",
      "name": "Validate & Evaluate Fraud Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "hold-decision",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "HOLD",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "not-approved",
              "leftValue": "={{ $json.approved }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "b60fa848-5c82-461e-8237-feb529ef8e29",
      "name": "Fraud Hold Required?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        896,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://qesrdltnvsdkjtaastkb.supabase.co/rest/v1/rpc/place_account_hold",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_account_id\": \"{{ $('Validate Request Payload').item.json.params.account_id }}\",\n  \"p_hold_type\": \"fraud_investigation\",\n  \"p_is_full_freeze\": true,\n  \"p_amount_held\": {{ $('Validate Request Payload').item.json.params.amount }},\n  \"p_reason\": \"Fraud Hold: {{ $('Validate & Evaluate Fraud Decision').item.json.reason }}\",\n  \"p_placed_by_profile_id\": {{ $('Validate Request Payload').item.json.params.profile_id ? '\"' + $('Validate Request Payload').item.json.params.profile_id + '\"' : null }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
