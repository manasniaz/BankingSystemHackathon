{
  "name": "WF-02 Standing Orders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "id": "06b28c4c-e1bf-4476-a307-0d460c2faa22",
      "name": "Schedule - Hourly Standing Order Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -608,
        112
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "standing_orders",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=status=eq.active&next_execution_at=lte.{{ $now.toUTC().toISO() }}&select=id,source_account_id,destination_account_id,amount,currency,frequency,next_execution_at,retry_count,last_error,status"
      },
      "id": "3054bbed-b410-474c-97c6-4a1eee33df1c",
      "name": "Fetch Due Standing Orders",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -400,
        112
      ],
      "credentials": {
        "supabaseApi": {
          "id": "tJhpbtV5Vin0bmon",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "orders-exist",
              "leftValue": "={{ Array.isArray($input.all()) && $input.all().length > 0 && !!$input.first().json.id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "fd7a4141-5812-4216-a028-f7cdfd8b16a2",
      "name": "Any Orders Due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -208,
        112
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "9cb38e0b-e0c2-46cb-a6c0-d1ec0b19ad8e",
      "name": "Process Orders One By One",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://qesrdltnvsdkjtaastkb.supabase.co/rest/v1/rpc/execute_standing_order",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_standing_order_id\": \"{{ $json.id }}\"\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "5586c45b-df3f-4e6c-b245-6d87b77d54a5",
      "name": "Execute Supabase RPC execute_standing_order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        208,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "tJhpbtV5Vin0bmon",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "exec-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "5a14f6ff-3d5d-4195-b8cc-ef39e5392e04",
      "name": "Check Execution Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "perm-failed",
              "leftValue": "={{ $json.status === 'failed' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "max-retries",
              "leftValue": "={{ $json.retry_count !== undefined && $json.retry_count >= 3 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "d9c89275-0066-42e6-b337-c97c068bc7e3",
      "name": "Permanent Failure?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        608,
        128
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "alert_msg",
              "name": "alert_summary",
              "type": "string",
              "value": "=CRITICAL: Standing order {{ $json.standing_order_id || 'unknown' }} failed permanently after {{ $json.retry_count || 3 }} retries. Reason: {{ $json.error || 'Unknown error' }}"
            },
            {
              "id": "standing_order_id",
              "name": "standing_order_id",
              "type": "string",
              "value": "={{ $json.standing_order_id }}"
            },
            {
              "id": "error_reason",
              "name": "error",
              "type": "string",
              "value": "={{ $json.error }}"
            }
          ]
        },
        "options": {}
      },
      "id": "8a0d94b7-852a-44b5-9200-f3a841e23a31",
      "name": "Format Permanent Failure Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        128
      ]
    },
    {
      "parameters": {
        "sendTo": "ops-team@yourbank.example",
        "subject": "ALERT: Standing Order Permanently Failed",
        "emailType": "text",
        "message": "={{ \"Standing Order Permanent Failure Alert\\n\\n\" + $json.alert_summary + \"\\n\\nStanding Order ID: \" + ($json.standing_order_id || \"unknown\") + \"\\nError: \" + ($json.error || \"Unknown\") + \"\\n\\nThis standing order has been permanently disabled after 3 failed retry attempts.\" }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a9d12e8f-c28c-4a71-b285-47b216f9528a",
      "name": "Email Ops Team - Standing Order Failed",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1008,
        128
      ],
      "webhookId": "0a210038-8ce5-42e6-b798-bdf108e481b3",
      "credentials": {
        "gmailOAuth2": {
          "id": "IrWmPXzOkHIt9fdU",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "s11-0001-4aaa-9001-aaaaaaaaaaa1",
      "name": "Split Affected Holders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        460
      ],
      "parameters": {
        "jsCode": "// One item per holder of the SOURCE account, so each gets their own email.\n// The RPC now returns this list precisely so the customer can be told; before,\n// the failure path knew only that something failed and who to alert internally.\nconst r = $('Permanent Failure?').first().json;\nconst emails = Array.isArray(r.holder_emails) ? r.holder_emails : [];\n\nconst amount = Number(r.amount || 0);\nreturn emails.filter(Boolean).map(email => ({ json: {\n  holderEmail: email,\n  standing_order_id: r.standing_order_id,\n  amount, amountFormatted: 'Rs ' + (amount / 100).toFixed(2),\n  frequency: r.frequency || 'recurring',\n  source_account_number: r.source_account_number,\n  destination_account_number: r.destination_account_number,\n  is_loan_repayment: Boolean(r.loan_repayment),\n  error: r.error || 'the payment could not be completed',\n  retry_count: r.retry_count || 3\n} }));"
      }
    },
    {
      "id": "s11-0002-4aaa-9002-aaaaaaaaaaa2",
      "name": "Email Customer - Standing Order Stopped",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1780,
        460
      ],
      "parameters": {
        "sendTo": "={{ $json.holderEmail }}",
        "subject": "=Your recurring payment of {{ $json.amountFormatted }} has stopped",
        "emailType": "text",
        "message": "=Hello,\n\nWe need to let you know that a recurring payment from your account has now stopped. We tried {{ $json.retry_count }} times and it did not go through, so we have cancelled it rather than keep retrying indefinitely.\n\nAmount: {{ $json.amountFormatted }}\nFrom: {{ $json.source_account_number }}\nTo: {{ $json.destination_account_number }}\nSchedule: {{ $json.frequency }}\nWhy it failed: {{ $json.error }}\n\nThe most common cause is not enough money in the account on the day the payment was due.\n\n{{ $json.is_loan_repayment ? 'IMPORTANT: this was your loan repayment. Your loan is still outstanding and has NOT been written off. Please reply to this email so we can arrange how you want to repay it - the sooner the better.' : 'WHAT TO DO NEXT\\nIf you still want this payment to happen, top the account up and reply to this email asking us to set it up again. If you meant to stop it, you do not need to do anything.' }}\n\nNo money has left your account for this payment.\n\nDigital Bank Payments",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "IrWmPXzOkHIt9fdU",
          "name": "Gmail account"
        }
      }
    }
  ],
